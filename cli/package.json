{
    "name": "@luna-agents/cli",
    "version": "0.1.0",
    "description": "AI agent platform CLI — run 28+ specialized coding agents from your terminal",
    "type": "module",
    "main": "dist/index.js",
    "bin": {
        "luna": "dist/index.js"
    },
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "start": "node dist/index.js",
        "typecheck": "tsc --noEmit",
        "lint": "eslint src/",
        "test": "vitest run",
        "prepublishOnly": "npm run build"
    },
    "keywords": [
        "luna",
        "lunaos",
        "ai",
        "agents",
        "code-review",
        "testing",
        "deployment",
        "cli",
        "mcp",
        "sdlc"
    ],
    "author": "Shachar Solomon",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/lunaos-ai/luna-agents.git",
        "directory": "cli"
    },
    "homepage": "https://lunaos.ai",
    "bugs": {
        "url": "https://github.com/lunaos-ai/luna-agents/issues"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "files": [
        "dist",
        "README.md"
    ],
    "dependencies": {
        "commander": "^12.1.0",
        "chalk": "^5.3.0",
        "ora": "^8.1.0",
        "inquirer": "^9.3.7",
        "glob": "^11.0.0",
        "yaml": "^2.5.1",
        "marked": "^14.1.4",
        "marked-terminal": "^7.2.1"
    },
    "devDependencies": {
        "tsup": "^8.3.5",
        "typescript": "^5.6.3",
        "@types/node": "^22.9.0",
        "vitest": "^2.1.5"
    }
}