---
import Book from "../layouts/Book.astro";
import ChapterOpener from "../components/ChapterOpener.astro";
import skillsData from "../data/skills.json";

// Real lexicon — every verb shipped in the npm package. The playground
// uses this to flag typos and warn before "execution".
const lexicon = Object.values(skillsData.byCategory)
  .flat()
  .map((s: any) => String(s.word).toLowerCase())
  .filter(Boolean);
const lexiconJson = JSON.stringify(lexicon);
const lexiconSize = lexicon.length;

const samples: { title: string; expr: string; note: string }[] = [
  { title: "Launch post fan-out",
    expr: 'persona generate >> ghost "launch post" * 4 >> publish notion',
    note: "Drafts personas, writes one post per persona, publishes all to Notion." },
  { title: "Security pipeline",
    expr: "security scan >> fix all >> create pr",
    note: "Scans the repo, applies fixes, opens a PR." },
  { title: "Issue triage",
    expr: "github issues >> summarize >> publish notion",
    note: "Pulls open issues, condenses to a sprint summary, posts to Notion." },
  { title: "Code review",
    expr: "code-review >> lint >> deploy staging",
    note: "Reviews changes, lints, deploys to staging on green." },
  { title: "Competitor research",
    expr: "research competitor >> summarize",
    note: "Maps competitors, extracts feature matrix, writes a brief." },
];
---

<Book
  title="Playground"
  chapter="play"
  description="Try Luna Pipes in the browser. Simulated execution; install luna-agents to run for real."
>
  <ChapterOpener
    num="05"
    word="Playground"
    subtitle={`Type a pipe; watch each stage. Validated live against the real ${lexiconSize}-verb lexicon — typos are flagged before execution. Execution itself is simulated; install luna-agents to run for real.`}
  />

  <section class="wrap">
    <form class="pg" id="pg-form" autocomplete="off">
      <label for="pg-input" class="pg-prompt" aria-hidden="true">&gt;&gt;</label>
      <input
        id="pg-input"
        name="pipe"
        type="text"
        spellcheck="false"
        autocorrect="off"
        placeholder='persona generate >> ghost "launch post" >> publish notion'
        aria-label="Type a Luna Pipes expression"
      />
      <button type="submit" class="pg-go">run</button>
    </form>
    <div class="pg-panes">
      <output id="pg-tree" class="pg-tree" data-label="Execution tree" aria-label="Parsed execution tree"></output>
      <output id="pg-trace" class="pg-trace" data-label="Stage trace" role="log" aria-live="polite"></output>
    </div>
    <div class="pg-shell" id="pg-shell" hidden>
      <p class="pg-shell-label">Run this for real:</p>
      <div class="pg-shell-row">
        <code id="pg-shell-cmd"></code>
        <button type="button" id="pg-shell-copy" class="pg-shell-copy">copy</button>
      </div>
      <p class="pg-shell-hint">
        Requires <a href="/install"><code>npm install -g luna-agents</code></a>.
        The playground simulates the trace; the binary runs the verbs.
      </p>
    </div>
    <script type="application/json" id="pg-lexicon" set:html={lexiconJson}></script>
  </section>

  <section class="wrap samples">
    <h2 class="samples-title">Starters.</h2>
    <ul class="samples-list">
      {samples.map((s) => (
        <li>
          <button class="sample" type="button" data-pipe={s.expr}>
            <code>{s.expr}</code>
            <span class="sample-note">{s.note}</span>
          </button>
        </li>
      ))}
    </ul>
  </section>
</Book>

<style>
  .pg {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: baseline;
    gap: 0.75ch;
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--rule);
    padding: var(--t-3) 0;
    margin-top: var(--t-6);
  }
  .pg-prompt {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: var(--step-2);
    letter-spacing: -0.05em;
    color: var(--saffron-deep);
  }
  #pg-input {
    background: none;
    border: 0;
    border-bottom: 1px solid var(--rule);
    padding: 0.35rem 0;
    font-family: var(--font-mono);
    font-size: var(--step-0);
    color: var(--ink);
    width: 100%;
  }
  #pg-input:focus { outline: 0; border-bottom-color: var(--saffron-deep); }
  .pg-go {
    background: var(--ink);
    color: var(--paper);
    border: 0;
    padding: 0.45rem 1rem;
    border-radius: 2px;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    cursor: pointer;
  }
  .pg-panes {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--t-3);
    margin-top: var(--t-3);
  }
  @media (max-width: 760px) { .pg-panes { grid-template-columns: 1fr; } }
  .pg-tree, .pg-trace {
    display: block;
    padding: var(--t-3);
    min-height: 12em;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    background: rgba(0, 0, 0, 0.04);
    border-radius: 2px;
    white-space: pre;
    color: var(--ink);
    overflow-x: auto;
  }
  .pg-tree::before, .pg-trace::before {
    content: attr(data-label);
    display: block;
    font-family: var(--font-display);
    font-style: italic;
    color: var(--muted);
    margin-bottom: var(--t-1);
    font-size: var(--step--1);
  }
  .pg-trace { white-space: pre-wrap; }
  .pg-trace .warn { color: #b8541a; }
  .pg-shell {
    margin-top: var(--t-3);
    padding: var(--t-2) var(--t-3);
    background: var(--paper-deep);
    border: 1px solid var(--rule);
    border-radius: 2px;
  }
  .pg-shell-label {
    margin: 0 0 0.4rem;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .pg-shell-row {
    display: flex;
    align-items: center;
    gap: var(--t-2);
    flex-wrap: wrap;
  }
  #pg-shell-cmd {
    font-family: var(--font-mono);
    font-size: var(--step-0);
    color: var(--ink);
    background: transparent;
    border: 0;
    padding: 0;
    overflow-x: auto;
    flex: 1;
    min-width: 0;
    white-space: pre;
  }
  .pg-shell-copy {
    background: var(--ink);
    color: var(--paper);
    border: 0;
    padding: 0.3rem 0.8rem;
    border-radius: 2px;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    cursor: pointer;
  }
  .pg-shell-copy.copied { background: var(--saffron-deep); }
  .pg-shell-hint {
    margin: var(--t-1) 0 0;
    font-size: var(--step--1);
    color: var(--muted);
  }
  .samples { padding-top: var(--t-6); padding-bottom: var(--t-8); }
  .samples-title {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--step-2);
    margin: 0 0 var(--t-3);
  }
  .samples-list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--rule);
  }
  .samples-list li { border-bottom: 1px solid var(--rule); margin: 0; }
  .sample {
    display: block;
    width: 100%;
    text-align: left;
    background: none;
    border: 0;
    padding: var(--t-2) 0;
    cursor: pointer;
    font-family: inherit;
    color: var(--ink);
  }
  .sample:hover { background: rgba(0, 0, 0, 0.03); }
  .sample code {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--step-0);
    color: var(--ink);
    background: none;
    border: 0;
    padding: 0;
  }
  .sample-note {
    display: block;
    font-size: var(--step--1);
    color: var(--muted);
    margin-top: 0.25rem;
  }
</style>

<script>
  import { simulate, renderTree, shellCommand, setLexicon } from "../lib/pipe-sim";

  const lexEl = document.getElementById("pg-lexicon");
  if (lexEl?.textContent) {
    try { setLexicon(JSON.parse(lexEl.textContent)); } catch {}
  }

  const form = document.getElementById("pg-form") as HTMLFormElement;
  const input = document.getElementById("pg-input") as HTMLInputElement;
  const trace = document.getElementById("pg-trace") as HTMLElement;
  const tree = document.getElementById("pg-tree") as HTMLElement;
  const shellBox = document.getElementById("pg-shell") as HTMLElement;
  const shellCmd = document.getElementById("pg-shell-cmd") as HTMLElement;
  const shellCopy = document.getElementById("pg-shell-copy") as HTMLButtonElement;

  const reduced = () => window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));

  function appendNode(line: string, klass?: string) {
    const div = document.createElement("div");
    if (klass) div.className = klass;
    div.textContent = line;
    trace.appendChild(div);
  }

  async function append(line: string, klass?: string) {
    appendNode(line, klass);
    if (!reduced()) await sleep(40);
  }

  async function run(expr: string) {
    trace.textContent = "";
    tree.textContent = renderTree(expr);
    shellCmd.textContent = shellCommand(expr);
    shellBox.hidden = false;
    for (const ev of simulate(expr)) {
      if (ev.kind === "parsed") {
        const k = ev.knownCount, u = ev.unknownCount;
        const note = u > 0 ? `, ${k} known + ${u} unknown verb${u === 1 ? "" : "s"}` : "";
        await append(`parsed: ${ev.stageCount} stage${ev.stageCount === 1 ? "" : "s"}${note}`);
      } else if (ev.kind === "stage-start") {
        const tag = `[${String(ev.index + 1).padStart(2, "0")}]`;
        const argTxt = ev.stage.args.length ? " " + ev.stage.args.map((a) => `"${a}"`).join(" ") : "";
        const marker = ev.known ? "" : " ⚠";
        await append(`${tag} ${ev.stage.verb}${argTxt}${marker}`);
      } else if (ev.kind === "stage-warn") {
        await append(`     ⚠ ${ev.text}`, "warn");
      } else if (ev.kind === "stage-line") {
        await append(`     ${ev.text}`);
      } else if (ev.kind === "stage-end") {
        await append(`     ok (${ev.ms}ms)`);
      } else if (ev.kind === "done") {
        const u = ev.unknownCount;
        const tail = u > 0
          ? ` (${u} unknown verb${u === 1 ? "" : "s"} would error at runtime)`
          : "";
        await append(`done in ${ev.totalMs}ms. simulated${tail}. install luna-agents to run for real.`);
      }
    }
  }

  form.addEventListener("submit", (e) => {
    e.preventDefault();
    const expr = input.value.trim();
    if (expr) run(expr);
  });

  shellCopy.addEventListener("click", async () => {
    try {
      await navigator.clipboard.writeText(shellCmd.textContent ?? "");
      shellCopy.classList.add("copied");
      shellCopy.textContent = "copied";
      setTimeout(() => {
        shellCopy.classList.remove("copied");
        shellCopy.textContent = "copy";
      }, 1500);
    } catch {
      // clipboard denied — silent
    }
  });

  for (const btn of document.querySelectorAll<HTMLButtonElement>(".sample")) {
    btn.addEventListener("click", () => {
      const expr = btn.dataset.pipe ?? "";
      input.value = expr;
      run(expr);
      input.scrollIntoView({ behavior: reduced() ? "auto" : "smooth", block: "start" });
    });
  }
</script>
