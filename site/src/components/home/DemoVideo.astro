---
// Demo video slot.
// To wire a real video: set `videoUrl` to an MP4 URL, OR set `embedUrl` to a
// YouTube/Vimeo embed URL. Provide a `poster` image for the loading state.
// Until a real URL is wired, this renders a marker frame so reviewers see the
// intended slot — no fake autoplay, no fabricated thumbnail.

interface Props {
  videoUrl?: string;
  embedUrl?: string;
  poster?: string;
  caption?: string;
}

const {
  videoUrl,
  embedUrl,
  poster = "/og.svg",
  caption = "60-second tour: one pipe builds a feature.",
} = Astro.props;
---

<section class="demo wrap">
  <p class="kicker">60 seconds</p>
  <h2 class="title">See the pipe ship a feature.</h2>
  <p class="lede">{caption}</p>

  <div class="frame">
    {embedUrl ? (
      <iframe
        src={embedUrl}
        title="Luna Pipes 60-second demo"
        loading="lazy"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen
      ></iframe>
    ) : videoUrl ? (
      <video controls preload="metadata" poster={poster}>
        <source src={videoUrl} type="video/mp4" />
        Your browser does not support the video tag.
        <a href={videoUrl}>Download the video</a>.
      </video>
    ) : (
      <div class="placeholder" role="img" aria-label="Demo video coming. View the showcase in the meantime.">
        <p class="ph-eyebrow">Video slot</p>
        <p class="ph-title">Demo video lands here.</p>
        <p class="ph-body">
          Until then, see the <a href="/showcase">animated showcase</a> for
          the four hero commands, or try the <a href="/play">playground</a>.
        </p>
      </div>
    )}
  </div>
</section>

<style>
  .demo {
    padding-top: var(--t-8);
    padding-bottom: var(--t-8);
    border-top: 1px solid var(--rule);
  }
  .kicker {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 var(--t-3);
  }
  .title {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    line-height: 1;
    letter-spacing: -0.015em;
    margin: 0 0 var(--t-2);
    text-wrap: balance;
  }
  .lede {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--step-2);
    color: var(--muted);
    max-width: 60ch;
    line-height: 1.3;
    margin: 0 0 var(--t-4);
  }
  .frame {
    aspect-ratio: 16 / 9;
    max-width: 980px;
    margin: 0;
    border: 1px solid var(--rule);
    background: #0e0c0a;
    overflow: hidden;
    border-radius: 4px;
    position: relative;
  }
  .frame video,
  .frame iframe {
    width: 100%;
    height: 100%;
    display: block;
    border: 0;
  }
  .placeholder {
    width: 100%;
    height: 100%;
    color: #d4cdbf;
    background:
      radial-gradient(800px 400px at 30% 0%, rgba(247,226,196,0.18), transparent 60%),
      radial-gradient(700px 300px at 80% 100%, rgba(168,85,247,0.12), transparent 60%),
      #0e0c0a;
    display: grid;
    place-content: center;
    padding: var(--t-4);
    text-align: center;
    gap: var(--t-2);
  }
  .ph-eyebrow {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: #8b8275;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    margin: 0;
  }
  .ph-title {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.8rem, 4vw, 3rem);
    color: var(--saffron);
    margin: 0;
    line-height: 1;
  }
  .ph-body {
    color: #b8b0a4;
    font-size: var(--step-0);
    max-width: 48ch;
    margin: 0 auto;
  }
  .placeholder a { color: var(--saffron); text-decoration-color: var(--saffron); }
</style>
