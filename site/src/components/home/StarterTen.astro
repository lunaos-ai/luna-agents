---
const starters = [
  { word: "rev",      gloss: "Code review with file:line citations.", canonical: "ll-review" },
  { word: "test",     gloss: "Generate + run the test suite.",         canonical: "ll-test" },
  { word: "ship",     gloss: "Deploy to your target (Cloudflare, Vercel, npm).", canonical: "ll-deploy" },
  { word: "pr",       gloss: "Open a pull request from current branch.", canonical: "ll-pr" },
  { word: "sec",      gloss: "OWASP-grade security scan + autofix.",    canonical: "ll-365-secure" },
  { word: "docs",     gloss: "Generate docs from code, not from prose.", canonical: "ll-docs" },
  { word: "rag",      gloss: "Semantic search across your codebase.",   canonical: "ll-nexa" },
  { word: "ghost",    gloss: "Long-form content drafted from your code or commits.", canonical: "ll-ghost" },
  { word: "no-bluf",  gloss: "Verifies every AI claim. Removes the lies.", canonical: "ll-no-bluf" },
  { word: "zen",      gloss: "One command, every gate green: a11y, sec, perf, tests, deploy.", canonical: "ll-zen" },
];
---

<section class="ten wrap">
  <p class="kicker">Starter ten · Forget the other 275 for now.</p>
  <h2>The ten verbs you'll actually type this week.</h2>
  <p class="lede">
    The lexicon has {285} entries. Most you'll meet later. These ten
    cover the day-one workflows — review, test, ship, audit, document,
    search — and compose into every recipe above.
  </p>
  <ol class="list">
    {starters.map((s, i) => (
      <li>
        <span class="n">{String(i + 1).padStart(2, "0")}</span>
        <code class="w">/{s.word}</code>
        <p class="g">{s.gloss}</p>
        <a class="more" href={`/lexicon#${s.canonical}`}>full entry →</a>
      </li>
    ))}
  </ol>
</section>

<style>
  .ten {
    padding-top: var(--t-6);
    padding-bottom: var(--t-8);
    border-top: 1px solid var(--rule);
  }
  .kicker {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 var(--t-3);
  }
  h2 {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(2rem, 4vw, 3.2rem);
    line-height: 1.05;
    letter-spacing: -0.015em;
    margin: 0 0 var(--t-3);
    text-wrap: balance;
  }
  .lede {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--step-1);
    color: var(--muted);
    max-width: 60ch;
    line-height: 1.3;
    margin: 0 0 var(--t-3);
  }
  .list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--rule);
  }
  .list li {
    display: grid;
    grid-template-columns: 3.5rem 11rem 1fr auto;
    gap: var(--t-2);
    align-items: baseline;
    padding: var(--t-2) 0;
    border-bottom: 1px solid var(--rule);
    margin: 0;
  }
  @media (max-width: 720px) {
    .list li {
      grid-template-columns: 3.5rem 1fr;
      gap: 0.5rem var(--t-2);
    }
    .list .g, .list .more { grid-column: 1 / -1; }
  }
  .n {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--muted);
  }
  .w {
    font-family: var(--font-mono);
    font-size: var(--step-1);
    color: var(--saffron-deep);
    background: transparent;
    border: 0;
    padding: 0;
  }
  .g {
    margin: 0;
    color: var(--ink);
  }
  .more {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--muted);
    text-decoration-color: var(--saffron-deep);
    white-space: nowrap;
  }
</style>
