{
  "name": "luna-agents",
  "owner": {
    "name": "Shachar Solomon",
    "email": "info@finsavvyai.com",
    "url": "https://github.com/shacharsol"
  },
  "plugins": [
    {
      "name": "luna-agents",
      "source": {
        "source": "github",
        "repo": "shacharsol/luna-agents"
      },
      "description": "🌙 Complete AI-powered development lifecycle management from requirements to post-launch monitoring",
      "version": "1.0.0",
      "author": {
        "name": "Shachar Solomon",
        "email": "info@finsavvyai.com"
      },
      "homepage": "https://finsavvyai.com/claude-code-plugin",
      "repository": "https://github.com/shacharsol/luna-agents",
      "license": "MIT",
      "keywords": [
        "ai",
        "development",
        "workflow",
        "automation",
        "requirements",
        "design",
        "testing",
        "deployment",
        "monitoring",
        "documentation",
        "code-review",
        "lifecycle",
        "full-stack",
        "devops",
        "architecture",
        "mcp",
        "browser-automation",
        "database",
        "web-testing",
        "monitoring",
        "observability",
        "infrastructure",
        "git",
        "playwright",
        "puppeteer",
        "postgresql",
        "sqlite",
        "grafana",
        "sentry"
      ],
      "category": "development",
      "commands": [
        "./commands/luna-requirements.md",
        "./commands/luna-design.md",
        "./commands/luna-plan.md",
        "./commands/luna-execute.md",
        "./commands/luna-review.md",
        "./commands/luna-test.md",
        "./commands/luna-deploy.md",
        "./commands/luna-docs.md",
        "./commands/luna-monitor.md",
        "./commands/luna-postlaunch.md"
      ],
      "agents": [
        "./agents/luna-requirements-analyzer.md",
        "./agents/design-architect.md",
        "./agents/luna-task-planner.md",
        "./agents/luna-task-executor.md",
        "./agents/luna-code-review.md",
        "./agents/luna-testing-validation.md",
        "./agents/luna-deployment.md",
        "./agents/luna-documentation.md",
        "./agents/luna-monitoring-observability.md",
        "./agents/luna-post-launch-review.md"
      ],
      
      "mcpServers": {
        "luna-filesystem": {
          "command": "npx",
          "args": [
            "-y",
            "@modelcontextprotocol/server-filesystem",
            "${CLAUDE_PLUGIN_ROOT}/projects"
          ]
        },
        "luna-git": {
          "command": "npx",
          "args": [
            "-y",
            "@modelcontextprotocol/server-git",
            "${CLAUDE_PLUGIN_ROOT}/projects"
          ]
        },
        "luna-memory": {
          "command": "npx",
          "args": ["-y", "@modelcontextprotocol/server-memory"]
        },
        "luna-sequential-thinking": {
          "command": "npx",
          "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"]
        },
        "luna-fetch": {
          "command": "npx",
          "args": ["-y", "@modelcontextprotocol/server-fetch"]
        },
        "luna-time": {
          "command": "npx",
          "args": ["-y", "@modelcontextprotocol/server-time"]
        },
        "luna-postgres": {
          "command": "npx",
          "args": ["-y", "@modelcontextprotocol/server-postgres"],
          "env": {
            "POSTGRES_CONNECTION_STRING": "${LUNA_DB_CONNECTION_STRING}"
          }
        },
        "luna-sqlite": {
          "command": "npx",
          "args": ["-y", "@modelcontextprotocol/server-sqlite", "${CLAUDE_PLUGIN_ROOT}/data/luna.db"]
        },
        "luna-playwright": {
          "command": "npx",
          "args": ["-y", "@modelcontextprotocol/server-playwright"],
          "env": {
            "HEADLESS": "true"
          }
        },
        "luna-puppeteer": {
          "command": "npx",
          "args": ["-y", "@puppeteer/mcp-server"]
        },
        "luna-grafana": {
          "command": "mcp-grafana",
          "env": {
            "GRAFANA_URL": "${LUNA_GRAFANA_URL}",
            "GRAFANA_SERVICE_ACCOUNT_TOKEN": "${LUNA_GRAFANA_TOKEN}"
          }
        },
        "luna-sentry": {
          "command": "node",
          "args": ["-e", "require('https://mcp.sentry.dev/mcp')"],
          "env": {
            "SENTRY_DSN": "${LUNA_SENTRY_DSN}",
            "SENTRY_AUTH_TOKEN": "${LUNA_SENTRY_TOKEN}"
          }
        }
      },
      "strict": false
    }
  ]
}