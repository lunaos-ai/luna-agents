  "faq": [
    {
      "question": "How do I install Luna Agents?",
      "answer": "Run '/plugin marketplace https://github.com/shacharsol/luna-agent' to add the marketplace, then '/plugin install luna-agents' to install the plugin."
    },
    {
      "question": "Does Luna work with existing projects?",
      "answer": "Yes! Luna can analyze any existing codebase and help improve it with requirements analysis, code review, testing, and documentation generation."
    },
    {
      "question": "Can I use Luna for specific features only?",
      "answer": "Absolutely! Luna supports both project-level and feature-level work. Just specify the feature name when prompted."
    },
    {
      "question": "How does Luna track progress?",
      "answer": "Luna uses a checkbox-based system in implementation-plan.md files, marking tasks as complete [x] as they're finished."
    },
    {
      "question": "What programming languages are supported?",
      "answer": "Luna works with virtually all programming languages and frameworks, analyzing code structure and generating appropriate solutions."
    }
