{
  "name": "luna-agents",
  "owner": {
    "name": "Shachar Solomon",
    "email": "info@finsavvyai.com",
    "url": "https://github.com/shacharsol"
  },
  "plugins": [
    {
      "name": "luna-agents",
      "source": {
        "source": "github",
        "repo": "shacharsol/luna-agent"
      },
      "description": "🌙 Complete AI-powered development lifecycle management from requirements to post-launch monitoring",
      "version": "1.0.0",
      "author": {
        "name": "Shachar Solomon",
        "email": "info@finsavvyai.com"
      },
      "homepage": "https://finsavvyai.com/claude-code-plugin",
      "repository": "https://github.com/shacharsol/luna-agent",
      "license": "MIT",
      "keywords": [
        "ai",
        "development",
        "workflow",
        "automation",
        "requirements",
        "design",
        "testing",
        "deployment",
        "monitoring",
        "documentation",
        "code-review",
        "lifecycle",
        "full-stack",
        "devops",
        "architecture",
        "mcp",
        "browser-automation",
        "database",
        "web-testing",
        "monitoring",
        "observability",
        "infrastructure",
        "git",
        "playwright",
        "puppeteer",
        "postgresql",
        "sqlite",
        "grafana",
        "sentry"
      ],
      "category": "development",
      "commands": [
        "./commands/luna-requirements.md",
        "./commands/luna-design.md",
        "./commands/luna-plan.md",
        "./commands/luna-execute.md",
        "./commands/luna-review.md",
        "./commands/luna-test.md",
        "./commands/luna-deploy.md",
        "./commands/luna-docs.md",
        "./commands/luna-monitor.md",
        "./commands/luna-postlaunch.md"
      ],
      "agents": [
        "./agents/luna-requirements-analyzer.json",
        "./agents/design-architect.json",
        "./agents/luna-task-planner.json",
        "./agents/luna-task-executor.json",
        "./agents/luna-code-review.json",
        "./agents/luna-testing-validation.json",
        "./agents/luna-deployment.json",
        "./agents/luna-documentation.json",
        "./agents/luna-monitoring-observability.json",
        "./agents/luna-post-launch-review.json"
      ],
      "hooks": {
        "SessionStart": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "${CLAUDE_PLUGIN_ROOT}/scripts/session-start.sh",
                "description": "Initialize Luna session, load workspace state, and validate environment"
              },
              {
                "type": "notification",
                "command": "${CLAUDE_PLUGIN_ROOT}/scripts/session-notification.sh",
                "description": "Welcome notification for new Luna session",
                "config": {
                  "title": "Luna Agents Started",
                  "message": "Luna development workflow initialized successfully",
                  "sound": false
                }
              }
            ]
          }
        ],
        "UserPromptSubmit": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "${CLAUDE_PLUGIN_ROOT}/scripts/prompt-analyzer.sh",
                "description": "Analyze user prompt for Luna context and task identification"
              },
              {
                "type": "command",
                "command": "${CLAUDE_PLUGIN_ROOT}/scripts/workspace-check.sh",
                "description": "Check if current directory is a valid Luna workspace"
              }
            ]
          }
        ],
        "PreToolUse": [
          {
            "matcher": "Write|Edit",
            "hooks": [
              {
                "type": "command",
                "command": "${CLAUDE_PLUGIN_ROOT}/scripts/check-permissions.sh",
                "description": "Check file permissions and production file protection",
                "block": false
              },
              {
                "type": "command",
                "command": "${CLAUDE_PLUGIN_ROOT}/scripts/file-backup.sh",
                "description": "Create backup of files before modification",
                "block": false
              }
            ]
          },
          {
            "matcher": "Bash|Shell",
            "hooks": [
              {
                "type": "command",
                "command": "${CLAUDE_PLUGIN_ROOT}/scripts/command-validator.sh",
                "description": "Validate shell commands for safety and compliance",
                "block": true
              }
            ]
          }
        ],
        "PostToolUse": [
          {
            "matcher": "Write|Edit",
            "hooks": [
              {
                "type": "command",
                "command": "${CLAUDE_PLUGIN_ROOT}/scripts/luna-progress-tracker.sh",
                "description": "Track Luna task progress and update implementation plan"
              },
              {
                "type": "command",
                "command": "${CLAUDE_PLUGIN_ROOT}/scripts/auto-format.sh",
                "description": "Auto-format code files (prettier, gofmt, rustfmt, etc.)"
              },
              {
                "type": "command",
                "command": "${CLAUDE_PLUGIN_ROOT}/scripts/log-command.sh",
                "description": "Log all executed commands for compliance and debugging"
              },
              {
                "type": "command",
                "command": "${CLAUDE_PLUGIN_ROOT}/scripts/feedback-check.sh",
                "description": "Provide automated feedback on code quality and conventions"
              },
              {
                "type": "command",
                "command": "${CLAUDE_PLUGIN_ROOT}/scripts/vcs-sync.sh",
                "description": "Sync changes with version control if configured"
              }
            ]
          },
          {
            "matcher": "Bash|Shell",
            "hooks": [
              {
                "type": "command",
                "command": "${CLAUDE_PLUGIN_ROOT}/scripts/log-command.sh",
                "description": "Log shell commands for debugging and audit"
              },
              {
                "type": "command",
                "command": "${CLAUDE_PLUGIN_ROOT}/scripts/result-analyzer.sh",
                "description": "Analyze shell command results for Luna context"
              }
            ]
          }
        ],
        "Notification": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "${CLAUDE_PLUGIN_ROOT}/scripts/notification-handler.sh",
                "description": "Handle and log Claude Code notifications in Luna context"
              }
            ]
          }
        ],
        "SubagentStop": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "${CLAUDE_PLUGIN_ROOT}/scripts/subagent-complete.sh",
                "description": "Handle Luna subagent completion and results processing"
              },
              {
                "type": "command",
                "command": "${CLAUDE_PLUGIN_ROOT}/scripts/task-completion-check.sh",
                "description": "Check if Luna tasks are complete and update status"
              }
            ]
          }
        ],
        "PreCompact": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "${CLAUDE_PLUGIN_ROOT}/scripts/compact-prep.sh",
                "description": "Prepare Luna workspace for Claude Code compact operation"
              },
              {
                "type": "command",
                "command": "${CLAUDE_PLUGIN_ROOT}/scripts/session-save.sh",
                "description": "Save Luna session state before compact"
              }
            ]
          }
        ],
        "Stop": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "${CLAUDE_PLUGIN_ROOT}/scripts/response-complete.sh",
                "description": "Process Claude Code response completion for Luna workflow"
              },
              {
                "type": "command",
                "command": "${CLAUDE_PLUGIN_ROOT}/scripts/workspace-state.sh",
                "description": "Update workspace state and progress indicators"
              }
            ]
          }
        ],
        "SessionEnd": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "${CLAUDE_PLUGIN_ROOT}/scripts/session-end.sh",
                "description": "Clean up Luna session, save final state, and generate summary"
              },
              {
                "type": "command",
                "command": "${CLAUDE_PLUGIN_ROOT}/scripts/session-report.sh",
                "description": "Generate session completion report with statistics"
              },
              {
                "type": "notification",
                "command": "${CLAUDE_PLUGIN_ROOT}/scripts/session-end-notification.sh",
                "description": "Session completion notification",
                "config": {
                  "title": "Luna Session Complete",
                  "message": "Development session ended. Workspace state saved.",
                  "sound": true,
                  "urgency": "low"
                }
              }
            ]
          }
        ],
        "Error": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "${CLAUDE_PLUGIN_ROOT}/scripts/error-handler.sh",
                "description": "Handle and log errors with Luna context and recovery suggestions"
              },
              {
                "type": "command",
                "command": "${CLAUDE_PLUGIN_ROOT}/scripts/error-recovery.sh",
                "description": "Attempt automatic error recovery for Luna workflows"
              },
              {
                "type": "notification",
                "command": "${CLAUDE_PLUGIN_ROOT}/scripts/error-notification.sh",
                "description": "Send critical error notifications",
                "config": {
                  "title": "Luna Error",
                  "message": "An error occurred during Luna workflow",
                  "sound": true,
                  "urgency": "critical"
                }
              }
            ]
          }
        ],
        "AwaitingInput": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "${CLAUDE_PLUGIN_ROOT}/scripts/input-detector.sh",
                "description": "Detect and log when Luna is awaiting user input"
              },
              {
                "type": "notification",
                "command": "${CLAUDE_PLUGIN_ROOT}/scripts/input-notification.sh",
                "description": "Send notification when awaiting user input",
                "config": {
                  "title": "Luna Agents",
                  "message": "Awaiting your input to continue...",
                  "sound": true,
                  "desktop": true,
                  "timeout": 30000
                }
              }
            ]
          }
        ],
        "PermissionRequest": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "${CLAUDE_PLUGIN_ROOT}/scripts/permission-check.sh",
                "description": "Validate permission requests against Luna security policies"
              },
              {
                "type": "notification",
                "command": "${CLAUDE_PLUGIN_ROOT}/scripts/permission-notification.sh",
                "description": "Send notification for permission requests",
                "config": {
                  "title": "Luna Permission Required",
                  "message": "Claude Code is requesting permission to run a command",
                  "sound": true,
                  "urgency": "normal"
                }
              }
            ]
          }
        ]
      },
      "mcpServers": {
        "luna-filesystem": {
          "command": "npx",
          "args": [
            "-y",
            "@modelcontextprotocol/server-filesystem",
            "${CLAUDE_PLUGIN_ROOT}/projects"
          ]
        },
        "luna-git": {
          "command": "npx",
          "args": [
            "-y",
            "@modelcontextprotocol/server-git",
            "${CLAUDE_PLUGIN_ROOT}/projects"
          ]
        },
        "luna-memory": {
          "command": "npx",
          "args": ["-y", "@modelcontextprotocol/server-memory"]
        },
        "luna-sequential-thinking": {
          "command": "npx",
          "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"]
        },
        "luna-fetch": {
          "command": "npx",
          "args": ["-y", "@modelcontextprotocol/server-fetch"]
        },
        "luna-time": {
          "command": "npx",
          "args": ["-y", "@modelcontextprotocol/server-time"]
        },
        "luna-postgres": {
          "command": "npx",
          "args": ["-y", "@modelcontextprotocol/server-postgres"],
          "env": {
            "POSTGRES_CONNECTION_STRING": "${LUNA_DB_CONNECTION_STRING}"
          }
        },
        "luna-sqlite": {
          "command": "npx",
          "args": ["-y", "@modelcontextprotocol/server-sqlite", "${CLAUDE_PLUGIN_ROOT}/data/luna.db"]
        },
        "luna-playwright": {
          "command": "npx",
          "args": ["-y", "@modelcontextprotocol/server-playwright"],
          "env": {
            "HEADLESS": "true"
          }
        },
        "luna-puppeteer": {
          "command": "npx",
          "args": ["-y", "@puppeteer/mcp-server"]
        },
        "luna-grafana": {
          "command": "mcp-grafana",
          "env": {
            "GRAFANA_URL": "${LUNA_GRAFANA_URL}",
            "GRAFANA_SERVICE_ACCOUNT_TOKEN": "${LUNA_GRAFANA_TOKEN}"
          }
        },
        "luna-sentry": {
          "command": "node",
          "args": ["-e", "require('https://mcp.sentry.dev/mcp')"],
          "env": {
            "SENTRY_DSN": "${LUNA_SENTRY_DSN}",
            "SENTRY_AUTH_TOKEN": "${LUNA_SENTRY_TOKEN}"
          }
        }
      },
      "strict": false
    }
  ]
}